{
  "name": "weavemx-viewer",
  "displayName": "WeaveMX Viewer",
  "description": "Zero-token custom editor that opens WeaveMX natively on any weave.md pipeline manifest.",
  "version": "1.2.0",
  "publisher": "axiomfab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/axiomfab/weavemx.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onCustomEditor:weavemx.viewer"
  ],
  "main": "./extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "weavemx.viewer",
        "displayName": "WeaveMX",
        "selector": [
          {
            "filenamePattern": "**/weave.md"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "weavemx.viewRawMarkdown",
        "title": "View Raw Markdown",
        "category": "WeaveMX",
        "icon": "$(code)"
      },
      {
        "command": "weavemx.openViewer",
        "title": "Open WeaveMX",
        "category": "WeaveMX",
        "icon": "$(preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "weavemx.viewRawMarkdown",
          "when": "activeCustomEditorId == weavemx.viewer",
          "group": "navigation@1"
        },
        {
          "command": "weavemx.openViewer",
          "when": "resourceFilename == weave.md && activeCustomEditorId != weavemx.viewer",
          "group": "navigation@1"
        }
      ]
    }
  }
}
